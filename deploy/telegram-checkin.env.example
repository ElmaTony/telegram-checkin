# Keep the dashboard on loopback and access over an SSH tunnel.
CHECKIN_GUI_HOST=127.0.0.1
CHECKIN_GUI_PORT=8577
# Persistent configuration, profiles, state and logs; separate from program files.
CHECKIN_HOME=/var/lib/telegram-checkin
PLAYWRIGHT_BROWSERS_PATH=/var/lib/telegram-checkin/data/browsers
# Set a long random token before enabling access from outside this server.
# CHECKIN_GUI_TOKEN=
# Optional: environment takes precedence over the key saved in data/secrets.json.
# SERVERCHAN_SENDKEY=
